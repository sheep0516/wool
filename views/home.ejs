<%- include('partials/head', { site: site, page: page, pageTitle: pageTitle, lib: lib }) %>

<%# 特色知识库：展示「最近更新」的前 3 个（server 端按 updatedAt 倒序算好），
    自动轮播、无切换按钮。不足 3 个就有几个轮几个。 %>
<% var featuredKbs = lib.featuredKbs || []; %>
<% var banner = site.banner || {}; %>

<section class="hero">
  <%# banner = 一张 929×333 的纯图；模板不叠任何文字，也不加压暗遮罩。
     换图只需替换 banner.image 指向的文件，无需改这里。 %>
  <div class="hero-banner<%= banner.image ? ' has-image' : '' %>"<% if (banner.image) { %> style="background-image:url('<%= base %><%= banner.image %>')"<% } %>></div>

  <aside class="hero-panel">
    <% if (featuredKbs.length) { %>
      <div class="hero-featured-stage" id="featuredStage">
        <% featuredKbs.forEach(function (kb, i) { %>
          <a class="hero-featured<%= i === 0 ? ' is-active' : '' %>" href="<%= kb.url %>"<%= i === 0 ? '' : ' aria-hidden="true" tabindex="-1"' %>>
            <span class="hero-featured-top"><span class="badge-new">NEW</span><span class="badge-text">知识库上新</span></span>
            <h2 class="hero-featured-title"><%= kb.title %></h2>
            <% if (kb.description) { %><p class="hero-featured-desc"><%= kb.description %></p><% } %>
            <span class="hero-tags">
              <span class="tag-pill"><%= kb.category %></span>
              <span class="tag-pill"><%= kb.chapterCount %> 章 · <%= kb.articleCount %> 篇</span>
            </span>
          </a>
        <% }); %>
      </div>
    <% } %>
    <div class="hero-stats">
      <div class="hero-stat">
        <span class="num"><%= lib.stats.kbs %></span>
        <span class="lbl">知识库总数</span>
        <span class="sub"><%= lib.groups.length %> 个分类</span>
      </div>
      <div class="hero-stat">
        <span class="num"><%= lib.stats.articles %></span>
        <span class="lbl">文章总数</span>
        <span class="sub">约 <%= (lib.stats.words / 10000).toFixed(1) %> 万字</span>
      </div>
      <div class="hero-stat">
        <span class="num"><%= lib.stats.chapters %></span>
        <span class="lbl">章节总数</span>
        <span class="sub"><%= lib.stats.updatedDate ? '更新于 ' + lib.stats.updatedDate.slice(5) : '本地内容' %></span>
      </div>
    </div>
  </aside>
</section>

<% if (!lib.kbs.length) { %>
  <div class="empty-state">
    <p>content/ 目录里还没有知识库。</p>
    <p class="muted">新建一个文件夹，放一个 <code>_meta.md</code>，再往里面放章节文件夹和 Markdown 文件就可以了。</p>
  </div>
<% } %>

<%# 每个分类一个 section，id 与顶栏分类导航的锚点同源（server.js 的 categoryAnchor）。 %>
<% lib.groups.forEach(function (group) { %>
  <section class="kb-group" id="<%= group.id %>">
    <h2 class="group-title"><%= group.category %></h2>
    <div class="card-grid">
      <% group.items.forEach(function (kb) { %>
        <article class="kb-card">
          <div class="kb-card-head">
            <span class="kb-icon" style="background:<%= kb.color %>"><%= kb.initial %></span>
            <h3 class="kb-card-title"><a href="<%= kb.url %>"><%= kb.title %></a></h3>
          </div>
          <% if (kb.description) { %><p class="kb-card-desc"><%= kb.description %></p><% } %>
          <div class="kb-card-foot">
            <span class="kb-card-meta"><%= kb.articleCount %> 篇<% if (kb.updatedDate) { %> · 更新于 <%= kb.updatedDate.slice(5) %><% } %></span>
            <a class="btn-open" href="<%= kb.url %>">开卷</a>
          </div>
        </article>
      <% }); %>
    </div>
  </section>
<% }); %>

<%# 右下角悬浮组：公众号 / 小红书两个模块 + 回到顶部按钮，整组由 .float-dock 固定，
    三者的顺序与间距都靠这个容器排（按钮原来的 position:fixed 已交给 dock）。
    素材直接引用 public/ICON/ 下的原图，不做裁剪缩放。 %>
<div class="float-dock">
  <div class="float-social">
    <div class="float-item" tabindex="0" aria-label="微信公众号：扫码关注">
      <img class="float-item-logo" src="<%= base %>/public/ICON/gzh_logo.png" alt="微信公众号" width="30" height="30">
      <span class="float-qr">
        <img class="float-qr-img" src="<%= base %>/public/ICON/gzh.png" alt="微信公众号二维码" width="146" height="146">
        <span class="float-qr-cap">扫码关注公众号</span>
      </span>
    </div>
    <div class="float-item" tabindex="0" aria-label="小红书：扫码查看">
      <img class="float-item-logo" src="<%= base %>/public/ICON/xhs_logo.png" alt="小红书" width="30" height="30">
      <span class="float-qr">
        <img class="float-qr-img" src="<%= base %>/public/ICON/xhs.png" alt="小红书二维码" width="146" height="146">
        <span class="float-qr-cap">扫码看小红书</span>
      </span>
    </div>
  </div>

  <button class="float-top" id="floatTop" type="button" aria-label="回到顶部">
    <span class="float-icon">↑</span>
    <span class="float-label">顶部</span>
  </button>
</div>

<script src="<%= base %>/public/home.js"></script>
<%- include('partials/foot', { site: site }) %>
